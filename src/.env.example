VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional — only needed if you want automatic confirm/reject emails.
# Leave these blank and the app works fine, it just won't send emails.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional — only needed if you want an email alert to the organizer
# every time a new application is submitted.
VITE_EMAILJS_ADMIN_TEMPLATE_ID=
VITE_ORGANIZER_NOTIFY_EMAIL=overseas.segefairs@gmail.com
